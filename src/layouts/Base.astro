---
import '../styles/global.css';
import { SITE } from '../config';
interface Props { title?: string; description?: string }
const { title, description = SITE.description } = Astro.props;
const full = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.title}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0e14" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <a class="skip" href="#main">Saltar al contenido</a>
  <header class="nav">
    <div class="wrap">
      <a class="logo" href={`${base}/`}>~/<span>pol</span>$</a>
      <nav aria-label="Principal">
        <ul>
          <li><a href={`${base}/#sobre-mi`}>Sobre mí</a></li>
          <li><a href={`${base}/#areas`}>Áreas</a></li>
          <li><a href={`${base}/#proyectos`}>Proyectos</a></li>
          <li><a href={`${base}/writeups/`}>Write-ups</a></li>
          <li><a href={`${base}/#trayectoria`}>Trayectoria</a></li>
          <li><a href={`${base}/#contacto`}>Contacto</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer>
    <div class="wrap">
      <span>© {new Date().getFullYear()} {SITE.fullName}</span>
      {SITE.links.portfolioRepo && <a href={SITE.links.portfolioRepo} rel="noopener noreferrer">Código del portfolio</a>}
    </div>
  </footer>
</body>
</html>
