---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('writeups')).filter((p) => !p.data.draft).sort((a, b) => +b.data.date - +a.data.date);
const fmt = new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Write-ups" description="Write-ups técnicos de laboratorios de sistemas y ciberseguridad.">
  <section><div class="wrap">
    <p class="eyebrow">Write-ups</p><h2>Notas técnicas</h2>
    {posts.length === 0 ? <p class="muted">Aún no hay artículos publicados.</p> :
    <ul class="posts">{posts.map((p) => (
      <li><a href={`${base}/writeups/${p.id}/`}>
        <span class="mono muted">{fmt.format(p.data.date)} · {p.data.category}</span>
        <h3>{p.data.title}{p.data.demo && <span class="demo">EJEMPLO</span>}</h3>
        <p>{p.data.summary}</p></a></li>
    ))}</ul>}
  </div></section>
</Base>
